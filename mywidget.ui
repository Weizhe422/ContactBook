    background-color: #2196F3;
    color: white;
}
QTableWidget::item:hover {
    background-color: #E3F2FD;
}
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #42A5F5, stop:1 #2196F3);
